# ── Secrets: never commit these ─────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ── Personal data (real resumes, generated reports, cached analyses) ──
data/samples/*
data/output/*
data/cache/*
!data/**/.gitkeep
*.pdf
*.docx
!docs/**/*.pdf

# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# ── Node / web ──────────────────────────────────────────
node_modules/
web/dist/
web/.vite/
*.log
npm-debug.log*

# ── OS / editor ─────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
