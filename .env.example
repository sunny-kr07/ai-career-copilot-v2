# Copy this file to `.env` and fill in your values:   cp .env.example .env
# `.env` is git-ignored. NEVER commit it or paste real keys into this example file.

# ── Required ────────────────────────────────────────────
# Free key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# ── Model (optional) ────────────────────────────────────
LLM_PROVIDER=google_genai
LLM_MODEL=gemma-4-26b-a4b-it
LLM_THINKING_LEVEL=minimal

# ── Job search (optional) ───────────────────────────────
# Adzuna API: free key from https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Country used by Indeed / Glassdoor scraping (python-jobspy)
JOBSPY_COUNTRY=India
# Optional proxies, comma separated:  user:pass@host:port
JOBSPY_PROXIES=

# ── API server (optional) ───────────────────────────────
# Comma-separated list of allowed browser origins in production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
